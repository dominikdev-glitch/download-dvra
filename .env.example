# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password to unlock the Admin Control Center (Default: 2005)
ADMIN_PASSWORD=2005

# ADMIN_CHAT_EMAIL: Primary email for live support and contact admin
ADMIN_CHAT_EMAIL=celiwamama@gmail.com

# CUSTOM_DOWNLOAD_URL: Direct URL to hosted software executable (GitHub Releases / Cloud CDN)
CUSTOM_DOWNLOAD_URL=https://github.com/dominikdev-glitch/download-dvra/releases/download/dvra/DVRA.Setup.1.0.2.exe

# FIREBASE SERVICE ACCOUNT (Set in Render Environment Variables):
# Option A: Full JSON string of serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Option B: Individual environment variables
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

